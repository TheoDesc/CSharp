<Window x:Class="WPF.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion administrateur"
        Height="220"
        Width="350"
        WindowStartupLocation="CenterScreen">


    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Label>
            Mot de passe administrateur
        </Label>


        <PasswordBox
            x:Name="txtMotDePasse"
            Height="30"
            Margin="0,25,0,0"
            Grid.Row="0"/>


        <Button
            Content="Connexion"
            Height="30"
            Margin="0,70,0,0"
            Grid.Row="0"
            Click="Connexion"/>


        <Button
            Content="Annuler"
            Height="30"
            Margin="0,115,0,-10"
            Grid.Row="0"
            Click="Annuler" Grid.RowSpan="3"/>


    </Grid>

</Window>