<Window x:Class="WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Annuaire Entreprise"
        Height="650"
        Width="1000">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Text="ANNUAIRE D'ENTREPRISE"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Zone de recherche -->
        <StackPanel Grid.Row="1">

            <WrapPanel Margin="0,0,0,10">

                <TextBlock Text="Nom / Prénom :"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <TextBox Name="txtRecherche"
                         Width="250"/>

            </WrapPanel>

            <WrapPanel Margin="0,0,0,20">

                <TextBlock Text="Site :"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <ComboBox Name="cbSite"
                          Width="180"
                          Margin="0,0,20,0"/>

                <TextBlock Text="Service :"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <ComboBox Name="cbService"
                          Width="180"
                          Margin="0,0,20,0"/>

                <Button Name="btnRechercher"
                        Content="Rechercher"
                        Width="120"/>

            </WrapPanel>

        </StackPanel>

        <!-- Tableau -->
        <DataGrid Name="dgSalaries"
          Grid.Row="2"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          MouseDoubleClick="dgSalaries_MouseDoubleClick" SelectionChanged="dgSalaries_SelectionChanged">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Nom"
                                    Binding="{Binding Nom}"/>

                <DataGridTextColumn Header="Prénom"
                                    Binding="{Binding Prenom}"/>

                <DataGridTextColumn Header="Téléphone"
                                    Binding="{Binding TelPortable}"/>

                <DataGridTextColumn Header="Service"
                                    Binding="{Binding Service}"/>

                <DataGridTextColumn Header="Site"
                                    Binding="{Binding Site}"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- Boutons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Name="btnFiche"
                    Content="Voir la fiche"
                    Width="130"
                    Margin="5"/>

            <Button Name="btnAdmin"
                    Content="Administration"
                    Width="130"
                    Margin="5"/>

        </StackPanel>

    </Grid>

</Window>